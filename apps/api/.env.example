# Application
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://onpilot:onpilot@localhost:5432/onpilot_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="replace-with-a-secure-secret"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# WhatsApp Cloud API (H2 — webhook de recepción)
# Token aleatorio que definimos nosotros; se repite en el panel de Meta al
# configurar la callback URL (verificación GET hub challenge).
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-verify-token"
# App Secret de la app de Meta (Configuración de la app → Básica). Con él se
# valida la firma X-Hub-Signature-256 del cuerpo crudo. JAMÁS commitear el real.
WHATSAPP_APP_SECRET="replace-with-meta-app-secret"
# phone_number_id del número de prueba (panel de WhatsApp → API Setup).
WHATSAPP_PHONE_NUMBER_ID="replace-with-test-phone-number-id"
# UUID del Business (negocio sandbox) al que se atribuyen los mensajes de ese
# número. Mecanismo v1-sandbox: mapeo por env, no hardcode en código.
WHATSAPP_BUSINESS_ID="replace-with-sandbox-business-uuid"