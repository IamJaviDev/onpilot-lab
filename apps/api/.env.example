# Application
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://onpilot:onpilot@localhost:5432/onpilot_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication — configurar cuando implementemos Auth
JWT_SECRET="replace-with-a-secure-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace-with-another-secure-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"