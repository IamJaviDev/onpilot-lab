# Application
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://onpilot:onpilot@localhost:5432/onpilot_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="replace-with-a-secure-secret"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# WhatsApp Cloud API (H2 — webhook de recepción)
# Token aleatorio que definimos nosotros; se repite en el panel de Meta al
# configurar la callback URL (verificación GET hub challenge).
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-verify-token"
# App Secret de la app de Meta (Configuración de la app → Básica). Con él se
# valida la firma X-Hub-Signature-256 del cuerpo crudo. JAMÁS commitear el real.
WHATSAPP_APP_SECRET="replace-with-meta-app-secret"
# phone_number_id del número de prueba (panel de WhatsApp → API Setup).
WHATSAPP_PHONE_NUMBER_ID="replace-with-test-phone-number-id"
# UUID del Business (negocio sandbox) al que se atribuyen los mensajes de ese
# número. Mecanismo v1-sandbox: mapeo por env, no hardcode en código.
WHATSAPP_BUSINESS_ID="replace-with-sandbox-business-uuid"
# Token permanente de System User para ENVIAR por la Graph API (sustituye a los
# tokens temporales de 24h del panel). Cómo generarlo:
# docs/features/h2-webhook-setup.md §7. JAMÁS commitear el real.
WHATSAPP_ACCESS_TOKEN="replace-with-system-user-token"

# IA — BotEngine (H2, Tarea 4)
# API key de Anthropic (console.anthropic.com → API Keys). Obligatoria
# (fail-fast al arrancar). Mismas reglas que el access token: JAMÁS commitear
# la real ni loguearla.
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
# BotEngine v0: responde con Claude Haiku a los mensajes entrantes (solo
# conversación informativa). Solo lo activa el string exacto 'true'; cualquier
# otro valor u omisión = off.
BOT_ENGINE_ENABLED=false

# Recordatorios de cita (H2, Tarea 7) — cola BullMQ sobre REDIS_URL.
# Solo lo activa el string exacto 'true'; cualquier otro valor u omisión = off
# (ni se programan jobs ni se procesan los que queden encolados).
REMINDERS_ENABLED=false
# SOLO para verificación manual: antelación en minutos que manda sobre las 24h
# por defecto (p. ej. 5 → el recordatorio de una cita a +10 min llega a +5).
# Dejar comentada en cualquier otro caso.
# REMINDERS_LEAD_MINUTES=5